        "# Quantização da imagem em tons de cinza utilizando NumPy\n",
        "\n",
        "def quantizar(imagem, bits):\n",
        "    niveis = 2 ** bits\n",
        "\n",
        "    # Calcula o tamanho de cada intervalo de intensidade\n",
        "    intervalo = 256 / niveis\n",
        "\n",
        "    # Identifica em qual intervalo cada pixel está\n",
        "    imagem_quantizada = np.floor(imagem / intervalo)\n",
        "\n",
        "    # Converte o índice do intervalo novamente para uma intensidade\n",
        "    imagem_quantizada = imagem_quantizada * (255 / (niveis - 1))\n",
        "\n",
        "    return imagem_quantizada.astype(np.uint8)\n",
        "\n",
        "\n",
        "# Gerando as imagens quantizadas\n",
        "img_1bit = quantizar(img_grey, 1)\n",
        "img_2bit = quantizar(img_grey, 2)\n",
        "img_4bit = quantizar(img_grey, 4)\n",
        "img_8bit = quantizar(img_grey, 8)"
      ],
